# Send every request that is not a real file or directory to the front controller.
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Force HTTPS before anything else, so a plain http:// request is redirected
    # once rather than bouncing through the trailing-slash rule first. The second
    # condition covers a proxy or CDN that terminates TLS and forwards over http.
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # Strip trailing slashes so /about/ and /about are the same page.
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.+?)/+$ /$1 [R=301,L]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L]
</IfModule>

# Long cache on fingerprinted assets; the asset() helper appends ?v=mtime.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css               "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/jpeg             "access plus 1 year"
    ExpiresByType image/png              "access plus 1 year"
</IfModule>

# Tell browsers to use HTTPS on their own for the next year. Sent on every
# response; a browser ignores it when it arrives over plain http, which is the
# only case the redirect above leaves. includeSubDomains is deliberately absent:
# it would also bind webmail, cpanel and any future subdomain.
<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

Options -Indexes
