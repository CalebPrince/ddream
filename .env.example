# Copy to .env and fill in. Never commit .env.
# On cPanel these come from MySQL Databases in the control panel.

DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ddream
DB_USER=ddream_user
DB_PASS=

# Local development only. Set DB_DRIVER=sqlite to run without a MySQL server;
# the migration runner translates the MySQL schema on the way in.
DB_SQLITE_PATH=storage/dev.sqlite

APP_ENV=production
APP_URL=https://diasporadomesticrem.com

# Where new enquiry notifications are sent. Comma separated.
MAIL_TO=info@diasporadomesticrem.com
MAIL_FROM=no-reply@diasporadomesticrem.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
